# Database Configuration
# Default to SQLite for zero-setup local execution; use PostgreSQL URL for production / Docker
DATABASE_URL=sqlite:///./compensation_equity.db
POSTGRES_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compensation_equity

# Core Application Settings
REPORTING_CURRENCY=USD
RANDOM_SEED=20261022
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit Dashboard Settings
DASHBOARD_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# Analytical Thresholds
COMPA_RATIO_MIN=0.80
COMPA_RATIO_MAX=1.20
DISPARITY_THRESHOLD_PERCENT=15.0
PERFORMANCE_EXEMPLARY_RATING=3.5
MIN_COMPARABLE_GROUP_SIZE=3
